# Copy to /etc/time-assistant.env (chmod 600). Secrets live here, never in the database.

# Timezone (otherwise taken from the Pi's system timezone)
TA_TZ=Asia/Kolkata

# Where the database and local backups live
# TA_DATA_DIR=/home/pi/time-assistant/data

# Owner UI + API (LAN). Public booking server stays on localhost for Tailscale Funnel.
TA_HOST=0.0.0.0
TA_PORT=8000
TA_PUBLIC_HOST=127.0.0.1
TA_PUBLIC_PORT=8001

# Free cloud AI (https://console.groq.com -> API Keys). Leave empty to run without AI.
GROQ_API_KEY=

# Gmail app password for booking emails (Google Account -> Security -> 2-Step Verification -> App passwords)
TA_SMTP_PASSWORD=
